{
    "name": "socketcan-cpp",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },

    // CAN FD integration tests need a virtual CAN interface (vcan0).
    // NET_ADMIN lets us create the link; SYS_MODULE + the read-only
    // /lib/modules mount let modprobe load the host's vcan module.
    "runArgs": [
        "--cap-add=NET_ADMIN",
        "--cap-add=SYS_MODULE"
    ],
    "mounts": [
        "source=/lib/modules,target=/lib/modules,type=bind,readonly"
    ],

    // Bring up vcan0 once the container is created.
    "onCreateCommand": "bash tests/setup_vcan.sh || echo 'vcan0 setup failed — ensure the host kernel provides the vcan module'",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools"
            ]
        }
    }
}
